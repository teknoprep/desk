#!/usr/bin/env python3
"""desk — a pick-and-place Omarchy desktop kit.

Pull this repo, run `./desk`, and choose what you want: a system monitor app, a
desk that survives a reboot, per-monitor windows that stay put, themes, terminal
and editor configs, the web-app launchers, the packages. Every piece is
independent: grab the ones you want, leave the rest.

    ./desk                      interactive picker
    ./desk list                 what is in the kit and whether it is installed
    ./desk install window-pin   install one thing, no questions
    ./desk install all --yes    install everything
    ./desk install all --dry-run
    ./desk agent                print the prompt to hand an AI agent instead

Everything is copied into your home directory, and anything it replaces is moved
to ~/.local/state/desk/backup-<timestamp>/ first. Nothing outside ~ is touched
unless you pick a component marked "sudo".
"""

from __future__ import annotations

import argparse
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent
HOME = Path(os.environ.get("HOME") or Path.home())
STATE = Path(os.environ.get("XDG_STATE_HOME") or (HOME / ".local/state")) / "desk"
STAMP = time.strftime("%Y%m%d-%H%M%S")
BACKUP = STATE / f"backup-{STAMP}"
DRY = False

BOLD, DIM, GREEN, YELLOW, RED, RESET = "", "", "", "", "", ""
if sys.stdout.isatty():
    BOLD, DIM, GREEN, YELLOW, RED, RESET = (
        "\033[1m", "\033[2m", "\033[32m", "\033[33m", "\033[31m", "\033[0m",
    )


# --------------------------------------------------------------------------- #
# helpers


def say(message=""):
    print(message)


def step(message):
    say(f"\n{BOLD}== {message}{RESET}")


def info(message):
    say(f"  {message}")


def warn(message):
    say(f"  {YELLOW}!{RESET} {message}")


def fail(message):
    say(f"  {RED}✗{RESET} {message}")


def ok(message):
    say(f"  {GREEN}✓{RESET} {message}")


def run(argv, cwd=None, quiet=False, check=True, sudo=False):
    if sudo:
        argv = ["sudo", *argv]
    if DRY:
        info(f"would: {' '.join(str(a) for a in argv)}")
        return subprocess.CompletedProcess(argv, 0, "", "")
    result = subprocess.run(
        [str(a) for a in argv],
        cwd=cwd,
        text=True,
        capture_output=quiet,
    )
    if check and result.returncode != 0:
        if quiet and result.stderr:
            say(result.stderr.strip())
        raise SystemExit(f"command failed ({result.returncode}): {' '.join(str(a) for a in argv)}")
    return result


def have(command):
    return shutil.which(command) is not None


def live():
    """Are we operating on the session we are running in?

    Compared against the passwd home, not $HOME: a sandbox run with
    HOME=/tmp/somewhere still resolves Path.home() to that same directory.
    """
    try:
        return HOME == Path(pwd.getpwuid(os.getuid()).pw_dir)
    except (KeyError, AttributeError):
        return False


def session_reload_hyprland():
    if have("hyprctl") and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and live():
        run(["hyprctl", "reload"], quiet=True, check=False)
    elif not live():
        info("not the running session: skipped hyprctl reload")


# --------------------------------------------------------------------------- #
# component sources

def sources(glob_list):
    """Repo-relative paths for a component's globs."""
    found = []
    for pattern in glob_list:
        matches = sorted(REPO.glob(pattern))
        if not matches:
            raise SystemExit(f"{pattern}: nothing in the repo matches this")
        found.extend(matches)
    return found


def files_of(paths):
    out = {}
    for path in paths:
        if path.is_dir():
            for child in sorted(path.rglob("*")):
                if child.is_file() or child.is_symlink():
                    out[child] = True
        else:
            out[path] = True
    return sorted(out)


def destination(repo_path):
    rel = repo_path.relative_to(REPO)
    parts = rel.parts
    if parts[0] == "home":
        return HOME.joinpath(*parts[1:])
    if parts[0] == "system":
        return Path("/").joinpath(*parts[1:])
    raise SystemExit(f"{rel}: not under home/ or system/")


def same(source, target):
    try:
        if source.is_symlink() or target.is_symlink():
            return source.is_symlink() and target.is_symlink() and os.readlink(source) == os.readlink(target)
        if target.stat().st_size != source.stat().st_size:
            return False
        return source.read_bytes() == target.read_bytes()
    except OSError:
        return False


def backup(target):
    root = HOME if target.is_relative_to(HOME) else Path("/")
    rel = target.relative_to(root)
    saved = BACKUP / rel
    saved.parent.mkdir(parents=True, exist_ok=True)
    if DRY:
        info(f"would back up {target}")
        return
    shutil.move(str(target), str(saved))


def place(source, target):
    """Copy one file, keeping symlinks and permissions."""
    if target.is_symlink() or target.exists():
        backup(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    if DRY:
        info(f"would install {target}")
        return
    if source.is_symlink():
        target.symlink_to(os.readlink(source))
    else:
        shutil.copy2(source, target)


def install_files(component):
    """Copy a component's files into place. Returns (installed, skipped)."""
    changed = 0
    kept = 0
    for repo_path in files_of(sources(component["paths"])):
        target = destination(repo_path)
        if same(repo_path, target):
            kept += 1
            continue
        if target.exists() and target.parts[1] == "etc":
            # /etc needs root; copy the old file aside with sudo too
            run(["install", "-Dm644", str(target), str(BACKUP / "system" / str(target.relative_to("/")))], sudo=True, check=False)
            run(["install", "-Dm644", str(repo_path), str(target)], sudo=True)
        else:
            place(repo_path, target)
        changed += 1
    return changed, kept


def status_of(component):
    if component.get("status"):
        return component["status"]()

    total = 0
    matching = 0
    for repo_path in files_of(sources(component["paths"])):
        target = destination(repo_path)
        total += 1
        if same(repo_path, target):
            matching += 1

    if matching == total and total:
        return "installed"
    if matching:
        return "partial"
    return "missing"


# --------------------------------------------------------------------------- #
# post-install actions


def box(component, body):
    """Edit a text file in place, only when needed, with a backup."""
    path = HOME / component
    if not path.exists():
        warn(f"{path} does not exist, skipping")
        return
    text = path.read_text()
    if body in text:
        return
    if not DRY:
        backup(path)
        path.write_text(text.rstrip("\n") + "\n" + body.lstrip("\n"))
    info(f"added to {path}")


def post_deskstate(component):
    for name in ("deskstate", "deskstate-preview", "deskstate-restore-window"):
        path = HOME / ".local/bin" / name
        if path.exists() and not DRY:
            path.chmod(0o755)

    hook = HOME / ".config/omarchy/hooks/post-boot.d/deskstate-restore"
    if hook.exists() and not DRY:
        hook.chmod(0o755)

    box(
        ".config/hypr/bindings.lua",
        '-- Rebuild the desktop recorded by deskstate.\n'
        'o.bind("SUPER + SHIFT + R", "Restore desktop session", "kitty --title deskstate -e deskstate-restore-window")\n',
    )

    if not live():
        info("not the running session: skipped systemctl --user")
        return

    if have("systemctl"):
        run(["systemctl", "--user", "daemon-reload"], quiet=True, check=False)
        run(
            ["systemctl", "--user", "enable", "--now",
             "deskstate-snapshot.timer", "deskstate-shutdown.service", "deskstate-watch.service"],
            quiet=True, check=False,
        )
        ok("snapshot timer, shutdown snapshot and the reconcile watcher are enabled")


def post_window_pin(component):
    box(
        ".config/hypr/hyprland.lua",
        '-- Keep windows on the workspace and monitor they were on across a display\n'
        '-- coming or going. See window-pin.lua.\n'
        'require("hypr.window-pin")\n',
    )
    session_reload_hyprland()


def post_hyprland(component):
    if not live():
        info("not the running session: skipped the Hyprland reload")
        return
    if not have("hyprctl"):
        warn("hyprctl not found: is this an Omarchy/Hyprland machine?")
        return
    errors = run(["hyprctl", "configerrors"], quiet=True, check=False).stdout.strip()
    if errors and not DRY:
        fail(f"Hyprland config errors:\n{errors}")
    else:
        ok("Hyprland config loads clean")
    session_reload_hyprland()
    info("monitors: this kit sets none. Arrange them once with the Displays app")
    info("          (SUPER + SPACE -> Setup -> Displays), or run ./desk run displays")


def install_displays(component):
    if have("nwg-displays"):
        info("nwg-displays is already installed")
    else:
        warn("installing nwg-displays (sudo)")
        if have("yay"):
            run(["yay", "-S", "--needed", "nwg-displays"])
        else:
            run(["pacman", "-S", "--needed", "nwg-displays"], sudo=True)
        ok("nwg-displays installed: SUPER + SPACE -> Setup -> Displays")


def status_displays():
    if not have("nwg-displays"):
        return "missing"
    layout = HOME / ".config/hypr/monitors.lua"
    return "installed" if layout.exists() else "set up"


def post_themes(component):
    if not live():
        info("not the running session: copied the themes and the recorded look only")
        return
    state = REPO / "state/omarchy"
    theme = (state / "theme.name").read_text().strip() if (state / "theme.name").exists() else ""
    background = (state / "background").read_text().strip() if (state / "background").exists() else ""
    font = (state / "font").read_text().strip() if (state / "font").exists() else ""

    if theme and have("omarchy"):
        run(["omarchy", "theme", "set", theme], quiet=True, check=False)
        info(f"theme      {theme}")
    if theme and background:
        background_file = HOME / f".local/state/omarchy/current/theme/backgrounds/{background}"
        if background_file.exists():
            run(["omarchy", "theme", "bg", "set", str(background_file)], quiet=True, check=False)
            info(f"background {background}")
        else:
            warn(f"background {background} not found for theme {theme}")
    if font and have("omarchy"):
        current = run(["omarchy", "font", "current"], quiet=True, check=False).stdout.strip()
        if current != font:
            run(["omarchy", "font", "set", font], quiet=True, check=False)
            info(f"font       {font} (was '{current or 'unknown'}')")


def post_shell(component):
    if not live():
        info("not the running session: skipped the shell restart")
        return
    if have("omarchy"):
        run(["omarchy", "restart", "shell"], quiet=True, check=False)
        ok("Omarchy shell restarted")


def post_idle(component):
    for name in ("idle-settings", "omarchy-patch-idle-blank", "screen-power"):
        path = HOME / ".local/bin" / name
        if path.exists() and not DRY:
            path.chmod(0o755)
    hook = HOME / ".config/omarchy/hooks/post-update.d/90-idle-blank-patch"
    if hook.exists() and not DRY:
        hook.chmod(0o755)

    patch = HOME / ".local/bin/omarchy-patch-idle-blank"
    if patch.exists() and not DRY and live():
        if run([str(patch), "--check"], quiet=True, check=False).returncode != 0:
            run([str(patch)], quiet=True, check=False)
            run(["omarchy", "restart", "shell"], quiet=True, check=False)
            ok("lock screen blank delay patched")
        else:
            info("lock screen patch already applied")
    warn("the machine-idle drop-in under /etc lands with sudo on the next component run")


def post_misc(component):
    """Regenerate the files that had this machine's home directory baked in."""
    bookmarks = HOME / ".config/gtk-3.0/bookmarks"
    lines = [
        f"file://{HOME}/Downloads Downloads",
        f"file://{HOME}/Documents Documents",
        f"file://{HOME}/Projects Projects",
        f"file://{HOME}/Pictures Pictures",
        f"file://{HOME}/Videos Videos",
    ]
    if DRY:
        info(f"would write {bookmarks}")
    else:
        bookmarks.parent.mkdir(parents=True, exist_ok=True)
        bookmarks.write_text("\n".join(lines) + "\n")
        info(f"wrote {bookmarks}")

    gitconfig = HOME / ".config/git/config"
    if gitconfig.exists():
        text = gitconfig.read_text()
        if "[user]" not in text:
            warn("git identity not set: git config --global user.name \"Your Name\"")
            warn("                          git config --global user.email you@example.com")



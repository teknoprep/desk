        say(f"{component['id']}\t{component_status(component)}")
    return 0


def parse_selection(text, components):
    picked = []
    for token in re.split(r"[,\s]+", text.strip()):
        if not token:
            continue
        if token in ("a", "all", "*"):
            return [c for c in components if not c.get("action")]
        if token in ("n", "none"):
            return []
        if token in BY_ID:
            picked.append(BY_ID[token])
            continue
        if re.fullmatch(r"\d+", token):
            index = int(token) - 1
            if 0 <= index < len(components):
                picked.append(components[index])
                continue
        if match := re.fullmatch(r"(\d+)-(\d+)", token):
            low, high = int(match.group(1)), int(match.group(2))
            picked.extend(components[low - 1:high])
            continue
        warn(f"ignoring '{token}'")
    seen = []
    for component in picked:
        if component not in seen:
            seen.append(component)
    return seen


def install_one(component):
    step(f"{component['title']} — {component['summary']}")

    if component.get("sudo"):
        warn("uses sudo")
    if component.get("replaces"):
        warn(f"replaces {component['replaces']}")
    if DRY:
        info("(dry run: nothing is written)")

    if component.get("installer"):
        component["installer"](component)
        return True

    changed, kept = install_files(component)
    if changed == 0:
        info(f"already up to date ({kept} files)")
    else:
        ok(f"{changed} files placed, {kept} already matched")

    if component.get("post"):
        component["post"](component)
    return True


def ask(prompt, default="n"):
    """input() that fails safe when there is no terminal to ask."""
    try:
        answer = input(prompt).strip().lower()
    except EOFError:
        say("")
        raise SystemExit("no terminal to ask on: pass --yes to install without questions")
    if not answer:
        answer = default
    return answer.lower() in ("y", "yes")


def cmd_install(args):
    if not args.ids:
        raise SystemExit("desk install <id …|all>   (run ./desk list to see the ids)")

    if args.ids == ["all"]:
        picked = [c for c in COMPONENTS if not c.get("action")]
    else:
        picked = []
        for name in args.ids:
            if name not in BY_ID:
                raise SystemExit(f"unknown component '{name}' (run ./desk list)")
            picked.append(BY_ID[name])

    if not args.yes and not DRY:
        say(f"{BOLD}About to install:{RESET} " + ", ".join(c["id"] for c in picked))
        if any(c.get("sudo") for c in picked):
            say(f"{YELLOW}some of these use sudo{RESET}")
        if not ask("Go ahead? [Y/n] ", default="y"):
            say("nothing done")
            return 1

    done = []
    skipped = []
    for component in picked:
        try:
            install_one(component)
            done.append(component["id"])
        except SystemExit as error:
            fail(f"{component['id']}: {error}")
            skipped.append(component["id"])
        except Exception as error:  # noqa: BLE001 - report, keep going
            fail(f"{component['id']}: {error}")
            skipped.append(component["id"])

    step("done")
    if done:
        ok(", ".join(done))
    if skipped:
        fail("not installed: " + ", ".join(skipped))
    if BACKUP.exists() and not DRY:
        info(f"replaced files are in {BACKUP}")
    if not skipped:
        info("next: ./desk list to see what else is missing")
    return 0 if not skipped else 1


def cmd_run(args):
    name = args.id
    if name not in BY_ID:
        raise SystemExit(f"unknown component '{name}'")
    command = BY_ID[name].get("run")
    if not command:
        raise SystemExit(f"{name} has nothing to run")
    if not have(command):
        raise SystemExit(f"{name} is not installed ({command} not on PATH)")
    os.execvp(command, [command])


def cmd_agent(args):
    text = (REPO / "ai/RESTORE_PROMPT.md").read_text()
    if args.copy and have("wl-copy"):
        subprocess.run(["wl-copy"], input=text, text=True, check=False)
        say(f"{GREEN}copied{RESET} the restore prompt to the clipboard")
    else:
        say(text)
    return 0


def interactive(args):
    while True:
        say(f"\n{BOLD}desk{RESET} — what should this machine have?{RESET}\n")
        width = max(len(c["id"]) for c in COMPONENTS) + 1
        for index, component in enumerate(COMPONENTS, 1):
            state = component_status(component)
            marker = "*" if component.get("sudo") else " "
            say(f" {index:>2}{marker} {component['id']:<{width}} {colour_status(state, 10)} {component['summary']}")
        say(f"\n  {DIM}* uses sudo · a = all · n = none · ?<num> = details · q = quit{RESET}")

        try:
            answer = input(f"{BOLD}Pick{RESET} [1-{len(COMPONENTS)}, a, n, q]: ").strip()
        except EOFError:
            say("")
            return 0

        if answer.lower() in ("q", "quit", "exit"):
            return 0
        if answer.startswith("?"):
            detail = parse_selection(answer[1:], COMPONENTS)
            if detail:
                component = detail[0]
                say(f"\n{BOLD}{component['title']}{RESET} — {component['summary']}")
                say(f"  status: {component_status(component)}")
                if component.get("replaces"):
                    say(f"  replaces: {component['replaces']}")
                say("  files:")
                for repo_path in files_of(sources(component["paths"]))[:40]:
                    try:
                        say(f"    {repo_path.relative_to(REPO)} -> {destination(repo_path)}")
                    except SystemExit:
                        say(f"    {repo_path.relative_to(REPO)} (read from the repo)")
                try:
                    input(f"\n{DIM}enter to go back{RESET} ")
                except EOFError:
                    return 0
            continue

        picked = parse_selection(answer, COMPONENTS)
        if not picked:
            return 0

        say(f"\n{BOLD}Selected:{RESET} " + ", ".join(c["id"] for c in picked))
        if any(c.get("sudo") for c in picked):
            say(f"{YELLOW}some of these use sudo{RESET}")
        try:
            go = input("Install? [Y/n] ").strip().lower()
        except EOFError:
            say("")
            return 1
        if go not in ("", "y", "yes"):
            continue

        for component in picked:
            try:
                install_one(component)
            except SystemExit as error:
                fail(f"{component['id']}: {error}")

        if BACKUP.exists():
            info(f"replaced files are in {BACKUP}")
        try:
            again = input("\nAnything else? [y/N] ").strip().lower()
        except EOFError:
            say("")
            return 0
        if again not in ("y", "yes"):
            return 0


def main(argv):
    global DRY

    parser = argparse.ArgumentParser(
        prog="desk",
        description="Pick and place an Omarchy desktop kit.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  ./desk                       interactive picker\n"
            "  ./desk list                  what is here, and what is installed\n"
            "  ./desk install window-pin    one thing\n"
            "  ./desk install all --dry-run\n"
            "  ./desk agent --copy          restore prompt for an AI agent\n"
        ),
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("list", help="list the components and their state")

    status_parser = sub.add_parser("status", help="machine-readable component state")
    status_parser.add_argument("-j", "--json", action="store_true", help="as json")

    install_parser = sub.add_parser("install", help="install components")
    install_parser.add_argument("ids", nargs="*", help="component ids, or 'all'")
    install_parser.add_argument("-y", "--yes", action="store_true", help="do not ask")
    install_parser.add_argument("-n", "--dry-run", action="store_true", help="only say what would happen")

    run_parser = sub.add_parser("run", help="run an installed component")
    run_parser.add_argument("id")

    agent_parser = sub.add_parser("agent", help="print the AI restore prompt")
    agent_parser.add_argument("-c", "--copy", action="store_true", help="copy it to the clipboard")

    args = parser.parse_args(argv)

    if args.command is None:
        return interactive(args)
    if args.command == "list":
        return cmd_list(args)
    if args.command == "status":
        states = {c["id"]: component_status(c) for c in COMPONENTS}
        if args.json:
            say(json.dumps(states, indent=2))
        else:
            for name, state in states.items():
                say(f"{name}\t{state}")
        return 0
    if args.command == "install":
        DRY = args.dry_run
        return cmd_install(args)
    if args.command == "run":
        return cmd_run(args)
    if args.command == "agent":
        return cmd_agent(args)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        say("\naborted")
        sys.exit(130)

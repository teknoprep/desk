# --------------------------------------------------------------------------- #
# commands


def component_status(component):
    try:
        return status_of(component)
    except SystemExit as error:
        return f"error: {error}"


def colour_status(state, width=0):
    pad = " " * max(0, width - len(state))
    if state == "installed":
        return f"{GREEN}{state}{RESET}{pad}"
    if state == "missing":
        return f"{DIM}{state}{RESET}{pad}"
    if state == "ready":
        return f"{DIM}{state}{RESET}{pad}"
    return f"{YELLOW}{state}{RESET}{pad}"


def cmd_list(args):
    width = max(len(c["id"]) for c in COMPONENTS) + 2
    say(f"{BOLD}desk{RESET} — {len(COMPONENTS)} things to grab or leave\n")
    for component in COMPONENTS:
        state = component_status(component)
        say(f"  {component['id']:<{width}}{colour_status(state, 10)} {component['summary']}")
        if component.get("sudo"):
            say(f"  {'':<{width}}{DIM}(uses sudo){RESET}")
    say(f"\n  {DIM}./desk install <id …|all> [--dry-run]   ./desk agent{RESET}")
    return 0


def cmd_status(args):

def install_vitals(component):
    source = REPO / "apps/vitals"
    deps = ["qmake6", "make", "g++"]
    missing = [d for d in deps if not have(d)]
    if missing:
        raise SystemExit(
            "vitals needs " + ", ".join(missing) + "\n"
            "  sudo pacman -S --needed base-devel qt6-base qt6-declarative qt6-wayland"
        )

    if DRY:
        info("would build apps/vitals with qmake6 + make and install into ~/.local")
        return

    with tempfile.TemporaryDirectory(prefix="vitals-") as build:
        run(["qmake6", str(source / "vitals.pro")], cwd=build, quiet=True)
        run(["make", "-j", str(os.cpu_count() or 2)], cwd=build, quiet=True)
        binary = Path(build) / "vitals"
        if not binary.exists():
            raise SystemExit("the build finished without a vitals binary")

        targets = {
            binary: HOME / ".local/bin/vitals",
            source / "pkgbuild/vitals.desktop": HOME / ".local/share/applications/vitals.desktop",
            source / "pkgbuild/vitals.svg": HOME / ".local/share/icons/hicolor/scalable/apps/vitals.svg",
        }
        for src, target in targets.items():
            place(src, target)
            if not DRY:
                target.chmod(0o755 if target.name == "vitals" else 0o644)

    if not DRY and have("update-desktop-database"):
        run(["update-desktop-database", str(HOME / ".local/share/applications")], quiet=True, check=False)
    ok("vitals installed in ~/.local/bin (in the menu as System Monitor)")


def status_vitals():
    if (HOME / ".local/bin/vitals").exists():
        return "installed"
    return "system" if have("vitals") else "missing"


def install_packages(component):
    extras = [line.strip() for line in (REPO / "packages/extras.txt").read_text().splitlines()]
    extras = [line for line in extras if line and not line.startswith("#")]
    if not extras:
        return
    warn(f"{len(extras)} packages: this needs sudo and the network")
    if have("yay"):
        run(["yay", "-S", "--needed", *extras])
    else:
        run(["pacman", "-S", "--needed", *extras], sudo=True)
    ok("packages installed")


def status_packages():
    extras = [
        line.strip()
        for line in (REPO / "packages/extras.txt").read_text().splitlines()
        if line.strip() and not line.strip().startswith("#")
    ]
    if not have("pacman"):
        return "missing"
    installed = set(
        run(["pacman", "-Qq"], quiet=True, check=False).stdout.split()
    )
    return "installed" if all(name in installed for name in extras) else "missing"


def show_agent(component):
    prompt = REPO / "ai/RESTORE_PROMPT.md"
    say(prompt.read_text())
    say(f"\n{DIM}Hand that to an agent, or run ./desk for the picker.{RESET}")


